{
  "expo": {
    "name": "vteam",
    "slug": "vteam",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "vteam",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#13111F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vteamvolleyball.app"
    },
    "android": {
      "package": "com.vteamvolleyball.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/vteam.png",
      "name": "vteam",
      "shortName": "vteam",
      "themeColor": "#7C4DFF",
      "backgroundColor": "#13111F",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow vteam to access your photos to set your profile picture."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow vteam to add events to your calendar."
        }
      ],
      "expo-web-browser",
      "@sentry/react-native"
    ]
  }
}
