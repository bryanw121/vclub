# Copy to .env (git-ignored) and fill in. Never commit real values.

# App + web build (read by Expo; also by the e2e suite and e2e:sweep)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the web origin shared links point to (#130). Unset: the production
# domain on native, the page's own origin on web.
# EXPO_PUBLIC_WEB_ORIGIN=https://vteamvolleyball.com

# Vercel functions (api/event-page.ts, api/og/event.tsx) read Supabase with
# these server-side copies of the public values; they fall back to the
# EXPO_PUBLIC_* pair above. Set them in Vercel → Settings → Environment Variables.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Playwright e2e: a dedicated test account on the Supabase project above.
# Both are required; there are no defaults. In CI they are repository secrets.
E2E_USERNAME=
E2E_PASSWORD=

# Optional: where the built web app is served (default http://localhost:8081)
# E2E_BASE_URL=
