# Copy to .env (git-ignored) and fill in. Never commit real values.

# App + web build (read by Expo; also by the e2e suite and e2e:sweep)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Playwright e2e: a dedicated test account on the Supabase project above.
# Both are required; there are no defaults. In CI they are repository secrets.
E2E_USERNAME=
E2E_PASSWORD=

# Optional: where the built web app is served (default http://localhost:8081)
# E2E_BASE_URL=
