{
  "routes": [
    {
      "src": "/(_expo/static|assets)/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/fonts/(.*)",
      "headers": { "cache-control": "public, max-age=604800, stale-while-revalidate=86400" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/event/(?<id>[0-9a-fA-F-]{36})/?", "dest": "/api/event-page?id=$id" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "functions": {
    "api/tunnel.ts": {
      "memory": 128
    },
    "api/event-page.ts": {
      "memory": 128,
      "includeFiles": "dist/index.html"
    }
  }
}
