{
  "routes": [
    {
      "src": "/(_expo/static|assets)/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/fonts/(.*)",
      "headers": { "cache-control": "public, max-age=604800, stale-while-revalidate=86400" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "functions": {
    "api/tunnel.ts": {
      "memory": 128
    }
  }
}
